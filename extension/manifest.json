{
  "manifest_version": 3,
  "name": "Campus Daily Connect",
  "version": "1.2.0",
  "description": "Connects your IIT Bombay Moodle and ResoBin timetable to Campus Daily. Your password stays on IITB sign-in pages.",
  "permissions": [
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "https://moodle.iitb.ac.in/*",
    "https://resobin.gymkhana.iitb.ac.in/*",
    "https://campusdaily.nexuspulsetech.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://campusdaily.nexuspulsetech.com/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
